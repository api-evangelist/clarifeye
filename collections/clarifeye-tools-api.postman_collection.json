        {
          "id": "75876cae-803a-4047-8164-8f1498ce60b2",
          "name": "Get tool parameters schema",
          "request": {
            "name": "Get tool parameters schema",
            "description": {
              "content": "Return the JSON schema describing the parameters accepted by\n[`runTool`](#operation/runTool) for this tool.\n\nThe schema is a list of parameter specs (`id`, `type`, `description`,\n`required`, and an optional `default`). The exact list depends on the\ntool's `tool_type` and configuration — for example a retrieval tool\nconfigured with `auto_include` tags exposes an extra `included_tags`\nparameter.\n\nUse the `id` of each entry as the key in the JSON body sent to\n[`runTool`](#operation/runTool).\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "tools",
                ":tool_id",
                "parameters",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "project_id",
                  "description": "(Required) UUID of the project"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "tool_id",
                  "description": "(Required) UUID of the tool"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "4e15d759-c537-4a8d-8ca9-149c6ece665a",
              "name": "JSON schema describing the tool's run parameters",
              "originalRequest": {
                "url": {
                  "path": [
                    "projects",
                    ":project_id",
                    "tools",
