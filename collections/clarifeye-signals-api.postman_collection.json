          "name": "Submit a signal",
          "request": {
            "name": "Submit a signal",
            "description": {
              "content": "Submit a signal about the project's content: the signal text itself,\nplus optional `context.additional_details` with extra context for the\nreviewer. The signal shows up in the review UI for domain experts.\n\n## Signal Types\n\n| Type | is_positive Value | Description |\n|------|-------------------|-------------|\n| Thumbs up | `true` | Positive signal |\n| Thumbs down | `false` | Negative signal |\n| Neutral | `null` | Neutral or no sentiment |",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "signals",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "project_id",
                  "description": "(Required) UUID of the project"
