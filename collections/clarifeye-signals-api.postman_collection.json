            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"context\": {\n    \"additional_details\": \"<string>\"\n  },\n  \"feedback\": \"<string>\",\n  \"is_positive\": \"<boolean>\"\n}",
