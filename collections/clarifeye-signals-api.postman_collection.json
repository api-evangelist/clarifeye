          "name": "List signals",
          "request": {
            "name": "List signals",
            "description": {
              "content": "Retrieve all signals for a project with optional filtering.\n\n**Access Control:**\n- Admins see all signals in the project\n- Regular users see only signals they submitted\n\n**Sorting:**\n- Results are ordered by most recently updated first (`updated_at` field)\n\n**Note:** For grouped views by conversation, use `/projects/{project_id}/signals/grouped_by_conversation/`",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "signals",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by signal status"
                },
                {
                  "disabled": false,
                  "key": "is_positive",
                  "value": "<boolean>",
                  "description": "Filter by sentiment"
                },
                {
                  "disabled": false,
                  "key": "search",
                  "value": "<string>",
                  "description": "Search in signal text or user email (case-insensitive)"
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results per page"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
