        {
          "id": "35741112-f758-47aa-aa24-22a6751a0d3c",
          "name": "List interviews",
          "request": {
            "name": "List interviews",
            "description": {
              "content": "Retrieve interviews for a project.\n\n- Admins see all interviews in the project.\n- Other members see only interviews assigned to them or that they created.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "interviews",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "assigned_to",
                  "value": "<string>",
                  "description": "Set to \"me\" to return only interviews assigned to (or created by) the requesting user."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter by status. Comma-separated for multiple values (e.g. \"pending,in_progress\")."
                },
                {
                  "disabled": false,
                  "key": "text",
                  "value": "<string>",
                  "description": "Case-insensitive search over the interview name and transcript."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results per page"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "project_id",
                  "description": "(Required) UUID of the project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
