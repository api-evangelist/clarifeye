        {
          "id": "cad99122-e7c7-4549-bc8d-31afde8e1360",
          "name": "Create and assign interviews",
          "request": {
            "name": "Create and assign interviews",
            "description": {
              "content": "Create and assign one interview per assignee. **Admin only.**\n\nProvide existing project members via `assignee_ids` and/or new people to\ninvite via `invite_emails` (at least one is required). Invitees are added\nas non-admin Contributors. A separate interview is created for each\nassignee and the response is the list of created interviews.\n\n`write_scope` defaults to `local`. A `global` write scope requires every\nassignee to already be a project admin and cannot be combined with\n`invite_emails`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "interviews",
                "assign",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "project_id",
                  "description": "(Required) UUID of the project"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"assignee_ids\": [\n    \"<uuid>\",\n    \"<uuid>\"\n  ],\n  \"invite_emails\": [\n    \"<email>\",\n    \"<email>\"\n  ],\n  \"topic\": \"<string>\",\n  \"write_scope\": \"local\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
