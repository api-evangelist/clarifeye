    {
      "id": "5222f41d-317f-4eaf-a50f-d94184ce9449",
      "name": "Pipeline Runs",
      "description": {
        "content": "Inspect pipeline runs queued by extraction flows or other pipeline triggers — list runs and fetch the details/status of a single run",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "1f1757d5-ac1b-4e80-a86a-11d24e770064",
          "name": "List pipeline runs",
          "request": {
            "name": "List pipeline runs",
            "description": {
              "content": "List all pipeline runs in the project, ordered by creation date (most\nrecent first). Use this to discover the `id` of a run returned by an\nextraction flow `run-sync` / `publish` call, or to monitor recent\nactivity.\n\nThe list response uses a lightweight serializer that omits the very\nlarge `chunk_ids` / `document_ids` arrays and truncates `raw_logs` to\nthe most recent entries. Fetch a single run via the detail endpoint\nto get the full payload.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "pipeline-runs",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter pipeline runs by status (e.g. `pending`, `running`, `completed`, `failed`)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "100",
                  "description": "Maximum number of results per page"
                },
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "0",
                  "description": "Number of results to skip for pagination"
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "project_id",
                  "description": "(Required) UUID of the project"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
