        {
          "id": "bc239b73-79ef-4a47-bece-e6ba1a049663",
          "name": "Get pipeline run details and status",
          "request": {
            "name": "Get pipeline run details and status",
            "description": {
              "content": "Retrieve the full details of a single pipeline run, including its\ncurrent `status`, the list of executed steps with their per-step\nstatus, and the aggregated `raw_logs` produced during execution.\n\nPoll this endpoint to track the progress of a run started via an\nextraction flow `run-sync` or `publish` call. A run is in a terminal\nstate when `status` is one of `completed`, `completed_with_warnings`,\n`failed`, or `aborted`.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "projects",
                ":project_id",
                "pipeline-runs",
                ":pipeline_run_id",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "project_id",
                  "description": "(Required) UUID of the project"
                },
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "pipeline_run_id",
                  "description": "(Required) UUID of the pipeline run"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
