{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clarifeye Platform Agent Settings Users API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List project users",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.app.clarifeye.ai/api/v1/projects/:project_id/users/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter by email (case-insensitive partial match)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve all users with access to a project."
        },
        {
          "info": {
            "name": "Remove user by email",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.app.clarifeye.ai/api/v1/projects/:project_id/users/remove-by-email/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Remove a user from the project using their email address. Users cannot remove themselves."
        },
        {
          "info": {
            "name": "Update user permissions",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://eu.app.clarifeye.ai/api/v1/projects/:project_id/users/:permission_id/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "permission_id",
                "value": "",
                "type": "path",
                "description": "UUID of the permission record"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a user's permissions on the project."
        }
      ]
    }
  ],
  "bundled": true
}