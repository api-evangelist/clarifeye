{
  "opencollection": "1.0.0",
  "info": {
    "name": "Clarifeye Platform Agent Settings Invitations API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Invitations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List invitations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://eu.app.clarifeye.ai/api/v1/projects/:project_id/invites/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by invitation status"
              },
              {
                "name": "search",
                "value": "",
                "type": "query",
                "description": "Filter by email (case-insensitive partial match)"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results per page"
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Number of results to skip for pagination"
              }
            ]
          },
          "docs": "Retrieve all invitations for a project with optional filtering by status."
        },
        {
          "info": {
            "name": "Invite user to project",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://eu.app.clarifeye.ai/api/v1/projects/:project_id/invites/invite/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Invite a user to join the project.\n- For new users (not registered): Creates a pending invite and sends an email.\n- For existing users: Automatically accepts the invite and sends a notification.\n"
        },
        {
          "info": {
            "name": "Cancel invitation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://eu.app.clarifeye.ai/api/v1/projects/:project_id/invites/:invite_id/",
            "params": [
              {
                "name": "project_id",
                "value": "",
                "type": "path",
                "description": "UUID of the project"
              },
              {
                "name": "invite_id",
                "value": "",
                "type": "path",
                "description": "UUID of the invitation"
              }
            ]
          },
          "docs": "Cancel a pending invitation. Only pending invitations can be cancelled."
        }
      ]
    }
  ],
  "bundled": true
}